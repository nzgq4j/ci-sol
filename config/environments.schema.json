{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dms.local/schemas/environments.schema.json",
  "title": "DMS environment configuration",
  "description": "Validated configuration model for DMS target environments. Traces to PRD ADM-005 (no hard-coded production values) and NFR-019 (configuration management).",
  "type": "object",
  "required": ["schemaVersion", "tenant", "environments"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "tenant": {
      "type": "object",
      "required": ["tenantName", "tenantId", "sharePointAdminUrl", "contentTypeHubUrl", "defaultTimeZone", "defaultLanguage"],
      "additionalProperties": false,
      "properties": {
        "tenantName": { "type": "string", "minLength": 1 },
        "tenantId": {
          "type": "string",
          "description": "Entra tenant GUID, or the literal REQUIRES_TENANT_DISCOVERY placeholder.",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|REQUIRES_TENANT_DISCOVERY)$"
        },
        "sharePointAdminUrl": { "type": "string", "pattern": "^https://[A-Za-z0-9-]+-admin\\.sharepoint\\.com/?$|^REQUIRES_TENANT_DISCOVERY$" },
        "contentTypeHubUrl": { "type": "string", "pattern": "^https://[A-Za-z0-9-]+\\.sharepoint\\.com/sites/[A-Za-z0-9-]+/?$|^REQUIRES_TENANT_DISCOVERY$" },
        "defaultTimeZone": { "type": "string", "minLength": 1, "description": "IANA time zone id, e.g. Europe/London. PRD A-005." },
        "defaultLanguage": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
        "auditRetentionDays": {
          "type": ["integer", "string"],
          "description": "PRD OQ-07. Purview Audit Standard is documented at 180 days; longer needs licensing confirmation.",
          "minimum": 1
        }
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["dev", "test", "prod"] },
      "additionalProperties": {
        "type": "object",
        "required": ["environmentType", "dmsSiteUrl", "allowProductionChanges", "allowIrreversiblePurviewChanges", "operatingMode"],
        "additionalProperties": false,
        "properties": {
          "environmentType": { "enum": ["dev", "test", "prod"] },
          "dmsSiteUrl": { "type": "string", "pattern": "^https://[A-Za-z0-9-]+\\.sharepoint\\.com/sites/[A-Za-z0-9-]+/?$|^REQUIRES_TENANT_DISCOVERY$" },
          "powerPlatformEnvironmentUrl": { "type": "string" },
          "powerPlatformEnvironmentId": { "type": "string" },
          "pilotBusinessUnit": { "type": "string" },
          "allowProductionChanges": {
            "type": "boolean",
            "description": "PRD safety control. MUST be false unless production deployment is explicitly authorised."
          },
          "allowIrreversiblePurviewChanges": {
            "type": "boolean",
            "description": "Gates regulatory records, Preservation Lock, automatic permanent disposition. PRD SEC-012, C-005, R-06."
          },
          "operatingMode": {
            "type": "string",
            "enum": ["Collaborative", "ControlledAuthoring", "PublishedConsumption", "Records", "AdministrativeRecovery"],
            "description": "PRD section 4.3 operating modes."
          },
          "externalSharing": {
            "type": "string",
            "enum": ["Disabled", "ExistingExternalUserSharingOnly", "ExternalUserSharingOnly", "ExternalUserAndGuestSharing"],
            "description": "PRD F-025 / SEC-005 require Disabled for MVP controlled sites unless an approved exception exists."
          },
          "staleCheckOutThresholdBusinessDays": { "type": "integer", "minimum": 1, "description": "PRD MET-008 initial threshold 3 business days." },
          "entraGroupPrefix": { "type": "string" },
          "requiresApprovalToDeploy": { "type": "boolean" }
        }
      }
    },
    "provisional": {
      "type": "array",
      "description": "Values that are safe defaults pending a PRD open-question answer. Blocks production deployment while non-empty and unacknowledged.",
      "items": {
        "type": "object",
        "required": ["setting", "openQuestion", "provisionalValue", "risk"],
        "additionalProperties": false,
        "properties": {
          "setting": { "type": "string" },
          "openQuestion": { "type": "string", "pattern": "^OQ-[0-9]{2}$" },
          "provisionalValue": { "type": "string" },
          "risk": { "type": "string" }
        }
      }
    }
  }
}
