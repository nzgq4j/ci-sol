{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dms.local/schemas/content-types.schema.json",
  "title": "DMS content types",
  "type": "object",
  "required": ["schemaVersion","group","contentTypes"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "description": { "type": "string" },
    "publishFrom": { "type": "string" },
    "group": { "type": "string", "minLength": 1 },
    "idConvention": { "type": "string" },
    "contentTypes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name","id","parentId","description","abstract"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "pattern": "^0x[0-9A-F]{4,}$" },
          "parentId": { "type": "string", "pattern": "^0x[0-9A-F]{4,}$" },
          "description": { "type": "string", "minLength": 1 },
          "abstract": { "type": "boolean" },
          "documentTemplate": { "type": ["string","null"] },
          "documentTypeValue": { "type": "string" },
          "requiredFields": { "type": "array", "items": { "type": "string", "pattern": "^Dms[A-Za-z0-9]+$" } },
          "optionalFields": { "type": "array", "items": { "type": "string", "pattern": "^Dms[A-Za-z0-9]+$" } },
          "criticalRule": { "type": "string" },
          "mvpTreatment": { "type": "string" },
          "status": { "type": "string" },
          "requirements": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
