{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dms.local/schemas/retention-map.schema.json",
  "title": "DMS retention map (file plan)",
  "type": "object",
  "required": ["schemaVersion","status","retentionClasses","irreversibleControlsGate"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "description": { "type": "string" },
    "status": { "enum": ["Provisional","Approved"] },
    "blockingOpenQuestion": { "type": "string" },
    "productionGate": { "type": "object" },
    "irreversibleControlsGate": { "type": "object" },
    "legalHoldInteraction": { "type": "object" },
    "proofOfDisposition": { "type": "object" },
    "retentionClasses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["recordClass","retentionAuthority","trigger","period","disposition","declareAsRecord","declareAsRegulatoryRecord","status"],
        "properties": {
          "recordClass": { "type": "string", "minLength": 1 },
          "appliesTo": { "type": "object" },
          "retentionAuthority": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "triggerType": { "enum": ["EventBased","CreationDate","LastModifiedDate","LabelApplied"] },
          "period": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["DispositionReview","RetainOnly","AutoDelete","REQUIRES_RECORDS_APPROVAL"] },
          "declareAsRecord": { "type": "boolean" },
          "declareAsRegulatoryRecord": {
            "type": "boolean",
            "description": "MUST be false unless separate written authorisation exists. Irreversible."
          },
          "status": { "enum": ["Provisional","Approved"] },
          "containsPersonalData": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
