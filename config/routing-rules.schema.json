{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dms.local/schemas/routing-rules.schema.json",
  "title": "DMS routing rules",
  "type": "object",
  "required": ["schemaVersion","resolution","ruleSets","conformanceVectors"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "description": { "type": "string" },
    "status": { "type": "string" },
    "resolution": {
      "type": "object",
      "required": ["algorithm","criteria","noMatchBehaviour","ambiguousMatchBehaviour"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "noMatchBehaviour": { "type": "string", "minLength": 1 },
        "ambiguousMatchBehaviour": { "type": "string", "minLength": 1 },
        "separationOfDuties": { "type": "string" }
      }
    },
    "ruleSets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name","documentType","businessFunction","sensitivity","active","stages"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "documentType": { "type": "string", "minLength": 1 },
          "businessFunction": { "type": "string", "minLength": 1 },
          "sensitivity": { "type": "string", "minLength": 1 },
          "active": { "type": "boolean" },
          "note": { "type": "string" },
          "stages": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sequence","name","mode","assignees","quorum","dueBusinessDays"],
              "properties": {
                "sequence": { "type": "integer", "minimum": 1 },
                "name": { "type": "string", "minLength": 1 },
                "mode": { "enum": ["Serial","Parallel"] },
                "assignees": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "quorum": { "enum": ["All","Any","Majority"] },
                "dueBusinessDays": { "type": "integer", "minimum": 1 },
                "escalateTo": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "conformanceVectors": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["input","expect"], "properties": { "expect": { "enum": ["match","ambiguous","nomatch"] } } }
    },
    "requirements": { "type": "array" }
  }
}
