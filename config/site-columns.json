{
  "schemaVersion": "1.0",
  "description": "Governed site columns for the DMS, published from the Content Type Hub. PRD F-001. Internal names are stable contracts: they are referenced by views, flows, search mappings, reports and provisioning scripts and MUST NOT be renamed after first deployment.",
  "fieldGroup": "DMS Controlled Metadata",
  "namingRule": "Internal names are prefixed 'Dms' and are created explicitly so SharePoint does not derive an encoded name from the display name.",
  "indexingBudget": {
    "note": "SharePoint Online enforces a per-list indexed-column limit. PRD NFR-004 requires that no operational view depends on an unindexed high-cardinality query.",
    "maxIndexedColumnsPerList": 20
  },
  "columns": [
    {
      "internalName": "DmsDocumentId", "displayName": "Document ID", "type": "Text", "maxLength": 64,
      "required": true, "indexed": true, "enforceUniqueValues": false,
      "searchManagedProperty": "DmsDocumentIdOWSTEXT", "searchable": true, "queryable": true, "retrievable": true,
      "dataOwner": "Document Control", "sensitivity": "Internal",
      "validation": { "rule": "Matches the approved namespace pattern and is unique among non-Obsolete revisions of different documents.", "pattern": "REQUIRES_STAKEHOLDER_DECISION_OQ-11", "provisionalPattern": "^[A-Z]{2,5}-[A-Z]{2,4}-[0-9]{3,5}$" },
      "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation", "note": "Assigned at triage (T-01) and immutable thereafter. Rename and move must not change it. PRD F-002." },
      "requirements": ["F-002", "DATA-001"]
    },
    {
      "internalName": "DmsDocumentType", "displayName": "Document Type", "type": "Choice", "fillInChoice": false,
      "choices": ["Policy", "SOP", "Work Instruction", "Standard", "Controlled Form or Template", "Business Operations Document", "External Document"],
      "required": true, "indexed": true,
      "searchManagedProperty": "DmsDocumentTypeOWSCHCS", "searchable": true, "queryable": true, "refinable": true,
      "dataOwner": "Document Control", "sensitivity": "Internal",
      "validation": { "rule": "Must match the content type in use. Provisioning validates that the value set is consistent with config/content-types.json." },
      "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring"], "setBy": "DocumentController", "note": "Changing type after authoring requires a new change request because routing and retention depend on it." },
      "requirements": ["F-001", "F-003", "DATA-001"]
    },
    {
      "internalName": "DmsBusinessFunction", "displayName": "Business Function", "type": "TaxonomyFieldType",
      "termSet": "Business Function", "allowMultipleValues": false,
      "required": true, "indexed": true, "refinable": true, "searchable": true, "queryable": true,
      "dataOwner": "Document Control", "sensitivity": "Internal",
      "validation": { "rule": "Must be an active term. Deprecated terms remain resolvable for history. PRD section 17.3." },
      "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "Author" },
      "requirements": ["F-001", "F-026", "DATA-001"]
    },
    {
      "internalName": "DmsBusinessProcess", "displayName": "Business Process", "type": "TaxonomyFieldType",
      "termSet": "Business Process", "allowMultipleValues": false,
      "required": true, "indexed": true, "refinable": true, "searchable": true, "queryable": true,
      "dataOwner": "Document Control", "sensitivity": "Internal",
      "validation": { "rule": "Must be an active term within the selected Business Function branch where the taxonomy defines that relationship." },
      "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "Author" },
      "requirements": ["F-001", "F-026", "DATA-001"]
    },
    {
      "internalName": "DmsDocumentOwner", "displayName": "Document Owner", "type": "User", "allowMultipleValues": false, "selectionMode": "PeopleOnly",
      "required": true, "indexed": true, "searchable": true, "queryable": true,
      "dataOwner": "Document Control", "sensitivity": "Personal",
      "validation": { "rule": "Must resolve to an active Entra identity. Departure raises an ownerless-document exception. PRD MET-005." },
      "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework", "Effective"], "setBy": "DocumentController", "note": "Ownership transfer while Effective is permitted and audited; it does not alter the approved revision." },
      "requirements": ["F-015", "F-024", "DATA-001"]
    },
    { "internalName": "DmsAuthor", "displayName": "Author", "type": "UserMulti", "selectionMode": "PeopleOnly", "required": false, "indexed": false, "dataOwner": "Document Owner", "sensitivity": "Personal", "validation": { "rule": "Active Entra identities or approved groups." }, "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "DocumentController" }, "requirements": ["DATA-001"] },
    { "internalName": "DmsReviewer", "displayName": "Reviewer", "type": "UserMulti", "selectionMode": "PeopleAndGroups", "required": false, "indexed": false, "dataOwner": "Document Control", "sensitivity": "Personal", "validation": { "rule": "Resolved from routing rules at submission; a manual override is audited." }, "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "DocumentController" }, "requirements": ["F-009", "DATA-004"] },
    { "internalName": "DmsApprover", "displayName": "Approver", "type": "UserMulti", "selectionMode": "PeopleAndGroups", "required": false, "indexed": false, "dataOwner": "Document Control", "sensitivity": "Personal", "validation": { "rule": "Must not equal the sole Author for the same revision. Separation of duties, PRD SEC-003." }, "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "DocumentController" }, "requirements": ["F-009", "SEC-003", "DATA-004"] },
    {
      "internalName": "DmsLifecycleStatus", "displayName": "Lifecycle Status", "type": "Choice", "fillInChoice": false,
      "choices": ["Requested", "Triaged", "Authoring", "In Review", "Rework", "Approved Pending Effective", "Effective", "Superseded", "Withdrawn", "Obsolete"],
      "defaultValue": "Authoring",
      "required": true, "indexed": true, "refinable": true, "searchable": true, "queryable": true,
      "searchManagedProperty": "DmsLifecycleStatusOWSCHCS",
      "dataOwner": "Document Control", "sensitivity": "Internal",
      "validation": { "rule": "Only values declared in config/lifecycle-states.json. Direct user edits are blocked by permission design; changes flow through the transition engine. PRD F-005." },
      "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation", "note": "Never a free-text or user-editable field in reader or author views." },
      "requirements": ["F-005", "F-012", "F-013"]
    },
    { "internalName": "DmsBusinessRevision", "displayName": "Business Revision", "type": "Text", "maxLength": 16, "required": true, "indexed": false, "searchable": true, "queryable": true, "dataOwner": "Document Control", "sensitivity": "Internal", "validation": { "rule": "Business revision is distinct from the SharePoint version. Convention pending OQ-11.", "provisionalPattern": "^[0-9]{1,3}(\\.[0-9]{1,2})?$" }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-002", "DATA-002"] },
    { "internalName": "DmsSharePointVersionRef", "displayName": "SharePoint Version Reference", "type": "Text", "maxLength": 16, "required": false, "indexed": false, "dataOwner": "Platform", "sensitivity": "Internal", "validation": { "rule": "The platform version label of the activated major version, e.g. 3.0. Recorded for evidence reconciliation." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-010", "NFR-011", "DATA-002"] },
    { "internalName": "DmsEffectiveDate", "displayName": "Effective Date", "type": "DateTime", "displayFormat": "DateOnly", "required": false, "indexed": true, "searchable": true, "queryable": true, "sortable": true, "dataOwner": "Document Control", "sensitivity": "Internal", "validation": { "rule": "Required before final approval. Stored in UTC; displayed in the tenant default time zone. PRD section 17.3." }, "lifecycleMutability": { "editableInStates": ["Authoring", "Rework", "InReview"], "setBy": "DocumentController" }, "requirements": ["F-012", "DATA-002"] },
    { "internalName": "DmsNextReviewDate", "displayName": "Next Review Date", "type": "DateTime", "displayFormat": "DateOnly", "required": false, "indexed": true, "queryable": true, "sortable": true, "dataOwner": "Document Owner", "sensitivity": "Internal", "validation": { "rule": "Calculated from DmsReviewFrequencyMonths and the effective date. May only move forward when an attributable review decision exists. PRD F-015." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-015", "MET-004"] },
    { "internalName": "DmsReviewFrequencyMonths", "displayName": "Review Frequency (months)", "type": "Number", "decimals": 0, "minimum": 1, "maximum": 120, "required": true, "indexed": false, "dataOwner": "Document Owner", "sensitivity": "Internal", "validation": { "rule": "Must match an active entry in the Review Frequencies list." }, "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework", "Effective"], "setBy": "DocumentOwner" }, "requirements": ["F-015"] },
    { "internalName": "DmsSensitivityClassification", "displayName": "Sensitivity Classification", "type": "Choice", "choices": ["Public", "Internal", "Confidential", "Highly Confidential"], "defaultValue": "Internal", "required": true, "indexed": true, "refinable": true, "dataOwner": "Security and Privacy", "sensitivity": "Internal", "validation": { "rule": "Business classification value. It does not itself apply a Purview sensitivity label; label mapping is defined in docs/PURVIEW_DESIGN.md. PRD SEC-006." }, "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "Author" }, "requirements": ["SEC-006", "SEC-008", "DATA-001"] },
    { "internalName": "DmsApplicability", "displayName": "Applicability", "type": "TaxonomyFieldTypeMulti", "termSet": "Applicability", "allowMultipleValues": true, "required": true, "indexed": false, "refinable": true, "queryable": true, "dataOwner": "Document Control", "sensitivity": "Internal", "validation": { "rule": "Defines the context within which exactly one revision may be effective. PRD F-013." }, "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "Author" }, "requirements": ["F-013", "F-026", "UX-003"] },
    { "internalName": "DmsSiteRegion", "displayName": "Site or Region", "type": "TaxonomyFieldTypeMulti", "termSet": "Site and Region", "allowMultipleValues": true, "required": false, "indexed": false, "refinable": true, "dataOwner": "Document Control", "sensitivity": "Internal", "validation": { "rule": "Optional in MVP. Multi-region retention variation is out of MVP scope. PRD OQ-16." }, "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "Author" }, "requirements": ["F-026", "UX-003"] },
    { "internalName": "DmsRetentionClass", "displayName": "Retention Class", "type": "Choice", "fillInChoice": false, "choices": ["REQUIRES_RECORDS_APPROVAL"], "choicesSource": "config/retention-map.example.json", "required": true, "indexed": true, "refinable": true, "dataOwner": "Records Management", "sensitivity": "Internal", "validation": { "rule": "Must reference an approved retention class. Provisional classes block production record capture. PRD F-018, R-03." }, "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "RecordsManager" }, "requirements": ["F-018", "DATA-007"] },
    { "internalName": "DmsTrainingRequired", "displayName": "Acknowledgement Required", "type": "Boolean", "defaultValue": false, "required": false, "indexed": false, "dataOwner": "Process Owner", "sensitivity": "Internal", "validation": { "rule": "Acknowledgement is read-and-understand evidence only. It is not competence certification. PRD F-029." }, "lifecycleMutability": { "editableInStates": ["Triaged", "Authoring", "Rework"], "setBy": "DocumentController" }, "requirements": ["F-029", "DATA-008"] },
    { "internalName": "DmsSupersedes", "displayName": "Supersedes", "type": "Text", "maxLength": 128, "required": false, "indexed": false, "queryable": true, "dataOwner": "Document Control", "sensitivity": "Internal", "validation": { "rule": "Document ID and business revision of the revision this one replaces." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-014"] },
    { "internalName": "DmsSupersededBy", "displayName": "Superseded By", "type": "Text", "maxLength": 128, "required": false, "indexed": false, "queryable": true, "dataOwner": "Document Control", "sensitivity": "Internal", "validation": { "rule": "Required when Lifecycle Status is Superseded. Withdrawal without a replacement leaves this empty. PRD section 17.3." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-014", "UX-004"] },
    { "internalName": "DmsChangeSummary", "displayName": "Change Summary", "type": "Note", "numberOfLines": 6, "richText": false, "required": true, "indexed": false, "searchable": true, "dataOwner": "Author", "sensitivity": "Internal", "validation": { "rule": "Required at submission. Shown to reviewers and approvers on the task. PRD UX-006." }, "lifecycleMutability": { "editableInStates": ["Authoring", "Rework"], "setBy": "Author" }, "requirements": ["F-008", "UX-006"] },
    { "internalName": "DmsApprovalCorrelationId", "displayName": "Approval Correlation ID", "type": "Text", "maxLength": 64, "required": false, "indexed": true, "queryable": true, "dataOwner": "Platform", "sensitivity": "Internal", "validation": { "rule": "GUID generated at submission. Joins the document, its approval evidence and any exception. PRD F-010, F-022." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-010", "F-022", "NFR-006"] },
    { "internalName": "DmsCurrentEffective", "displayName": "Current Effective", "type": "Boolean", "defaultValue": false, "required": false, "indexed": true, "queryable": true, "refinable": true, "dataOwner": "Document Control", "sensitivity": "Internal", "validation": { "rule": "Exactly one item may be true per Document ID and applicability context. Reconciliation reports zero or multiple. PRD F-013." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation", "note": "Maintained as an indexed boolean rather than derived, so default reader views filter without an unindexed query. PRD NFR-004." }, "requirements": ["F-013", "F-026", "NFR-004"] },
    { "internalName": "DmsSubmittedVersion", "displayName": "Submitted Version", "type": "Text", "maxLength": 16, "required": false, "indexed": false, "dataOwner": "Platform", "sensitivity": "Internal", "validation": { "rule": "Platform version label captured at submission. PRD F-008." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-008", "NFR-011"] },
    { "internalName": "DmsSubmittedETag", "displayName": "Submitted ETag", "type": "Text", "maxLength": 128, "required": false, "indexed": false, "dataOwner": "Platform", "sensitivity": "Internal", "validation": { "rule": "ETag captured at submission and re-checked before approval and again before activation. A mismatch invalidates the approval. PRD F-008, NFR-011, R-05." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-008", "NFR-011"] },
    { "internalName": "DmsApprovedETag", "displayName": "Approved ETag", "type": "Text", "maxLength": 128, "required": false, "indexed": false, "dataOwner": "Platform", "sensitivity": "Internal", "validation": { "rule": "ETag at the moment of final approval. Revalidated by the activation flow before publishing. PRD F-012." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-012", "NFR-011"] },
    { "internalName": "DmsRecordClass", "displayName": "Record Class", "type": "Choice", "fillInChoice": false, "choices": ["REQUIRES_RECORDS_APPROVAL"], "choicesSource": "config/retention-map.example.json", "required": false, "indexed": true, "refinable": true, "appliesToContentTypes": ["Operational Record"], "dataOwner": "Records Management", "sensitivity": "Internal", "validation": { "rule": "Required on Operational Record. Must map to an approved retention class before production capture. PRD F-018." }, "lifecycleMutability": { "editableInStates": ["*"], "setBy": "RecordsManager" }, "requirements": ["F-018", "DATA-006"] },
    { "internalName": "DmsEventDate", "displayName": "Event Date", "type": "DateTime", "displayFormat": "DateOnly", "required": false, "indexed": true, "sortable": true, "appliesToContentTypes": ["Operational Record"], "dataOwner": "Business Process Owner", "sensitivity": "Internal", "validation": { "rule": "The retention trigger date for event-based retention. Must not precede the logical event unless approved as migrated historical data. PRD section 17.3." }, "lifecycleMutability": { "editableInStates": ["*"], "setBy": "BusinessUser" }, "requirements": ["F-018", "DATA-006"] },
    { "internalName": "DmsRelatedDocumentId", "displayName": "Related Controlled Document", "type": "Text", "maxLength": 64, "required": false, "indexed": true, "queryable": true, "appliesToContentTypes": ["Operational Record"], "dataOwner": "Business Process Owner", "sensitivity": "Internal", "validation": { "rule": "Links a completed record to the controlled form or SOP that produced it. PRD F-003." }, "lifecycleMutability": { "editableInStates": ["*"], "setBy": "BusinessUser" }, "requirements": ["F-003", "DATA-006"] },
    { "internalName": "DmsSourceProvenance", "displayName": "Source Provenance", "type": "Note", "numberOfLines": 4, "richText": false, "required": false, "indexed": false, "dataOwner": "Migration Lead", "sensitivity": "Internal", "validation": { "rule": "Set only by migration. Records source path, source identifier, source timestamps and hash where chain of custody requires it. PRD DATA-012, C-009." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-037", "DATA-012"] },
    { "internalName": "DmsMigrationBatchId", "displayName": "Migration Batch ID", "type": "Text", "maxLength": 64, "required": false, "indexed": true, "queryable": true, "dataOwner": "Migration Lead", "sensitivity": "Internal", "validation": { "rule": "Joins a migrated item to its migration evidence record for reconciliation." }, "lifecycleMutability": { "editableInStates": [], "setBy": "SystemAutomation" }, "requirements": ["F-037", "DATA-012"] }
  ]
}
