# DMS environment variables — PLACEHOLDERS ONLY.
#
# No real credential is ever committed to this repository (PRD SEC-004).
# Prefer managed identity or certificate-based application authentication over any secret.
#
# Interactive deployment needs none of these; it uses Connect-PnPOnline -Interactive.

# Entra application (certificate-based authentication is preferred over a client secret)
DMS_TENANT_ID=00000000-0000-0000-0000-000000000000
DMS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Certificate thumbprint of a certificate held in the machine or user store.
# Do NOT put a certificate file or its password in this repository.
DMS_CERTIFICATE_THUMBPRINT=REPLACE_WITH_THUMBPRINT

# Target site for the chosen environment
DMS_SITE_URL=https://contoso.sharepoint.com/sites/dms-dev

# Where a client secret is genuinely unavoidable, retrieve it at run time from an approved secrets
# service (Azure Key Vault or equivalent). Never store the value here.
# DMS_CLIENT_SECRET_KEYVAULT_REFERENCE=https://<vault>.vault.azure.net/secrets/<name>
