{
  "name": "sol-document-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:ui": "node scripts/verify-ui.mjs",
    "sync:sharepoint": "node scripts/sync-spfx.mjs",
    "install:sharepoint": "npm --prefix sharepoint/sol-dms install",
    "package:sharepoint": "npm run sync:sharepoint && npm --prefix sharepoint/sol-dms run build",
    "verify": "npm run typecheck && npm run test && npm run build && npm run package:sharepoint && npm run verify:ui"
  },
  "dependencies": {
    "react": "17.0.1",
    "react-dom": "17.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^17.0.87",
    "@types/react-dom": "^17.0.26",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  }
}
