{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dms.local/schemas/lifecycle-states.schema.json",
  "title": "DMS lifecycle state model",
  "type": "object",
  "required": ["schemaVersion","fieldInternalName","states","transitions","invalidTransitionBehaviour","conformanceVectors"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "description": { "type": "string" },
    "fieldInternalName": { "type": "string", "pattern": "^Dms[A-Za-z0-9]+$" },
    "currentEffectiveFieldInternalName": { "type": "string", "pattern": "^Dms[A-Za-z0-9]+$" },
    "platformApprovalStatus": { "type": "object" },
    "states": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["key","displayName","order","isTerminal","currentEffective","readerVisible","description"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "isTerminal": { "type": "boolean" },
          "currentEffective": { "type": "boolean" },
          "readerVisible": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "requirements": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id","from","to","trigger","allowedActors","preconditions","systemEffects","evidenceCreated","requirements","idempotencyKey"],
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]{2}$" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "trigger": { "type": "string", "minLength": 1 },
          "allowedActors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "systemEffects": { "type": "array", "items": { "type": "string" } },
          "evidenceCreated": { "type": "array", "items": { "type": "string" } },
          "requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "workflow": { "type": "string", "pattern": "^WF-[0-9]{2}$" },
          "idempotencyKey": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "nonTransitionEvents": { "type": "array" },
    "invalidTransitionBehaviour": {
      "type": "object",
      "required": ["action","mustNotSilentlyCoerce"],
      "properties": {
        "action": { "const": "Reject" },
        "description": { "type": "string" },
        "mustNotSilentlyCoerce": { "const": true },
        "examples": { "type": "array" },
        "requirements": { "type": "array" }
      }
    },
    "recoveryBehaviour": { "type": "object" },
    "conformanceVectors": {
      "type": "object",
      "required": ["valid","invalid"],
      "properties": {
        "description": { "type": "string" },
        "valid":   { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["from","to","actor"] } },
        "invalid": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["from","to","actor"] } }
      }
    }
  }
}
